{
  "name": "dsh-doc-converter",
  "version": "0.1.5",
  "description": "Local deterministic document conversion and versioned styles for DSH",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "host/*.js", "client.js", "python/doc_converter/**/*.py", "python/requirements.txt", "scripts/setup-python.mjs", "cordis.patch.yml", "locale/*.json", "icon.svg", "THIRD_PARTY_NOTICES.txt", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "pack:check": "npm pack --dry-run --json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "devDependencies": {
    "@tabler/icons-react": "3.47.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3"
  }
}
